{
  "$description": "Tokens da identidade visual Votação DigiTech (UniCatólica). Fonte única: o CSS em public/css/tokens.css é gerado a partir deste arquivo (php design/tokens/gerar-css.php). Formato W3C Design Tokens (DTCG), importável no Figma pelo plugin Tokens Studio.",
  "cor": {
    "laranja": {
      "$type": "color",
      "$description": "Cor da marca. 500 é o laranja do logotipo; 600 é o do símbolo. Texto e botões com texto branco usam 700 ou mais escuro (contraste ≥ 4.5:1).",
      "50": { "$value": "#FFF4EB" },
      "100": { "$value": "#FFE4CC" },
      "200": { "$value": "#FFC799" },
      "300": { "$value": "#FCA65E" },
      "400": { "$value": "#F8933A" },
      "500": { "$value": "#F5821F", "$description": "Laranja do logotipo. Só em áreas grandes, ícones e detalhes; nunca texto pequeno sobre branco (2.6:1)." },
      "600": { "$value": "#EB681C", "$description": "Laranja do símbolo." },
      "700": { "$value": "#B5480A", "$description": "Ação primária. Branco sobre ele: 5.4:1." },
      "800": { "$value": "#963A0A", "$description": "Ação primária em hover/pressionado." },
      "900": { "$value": "#6B2A08" }
    },
    "grafite": {
      "$type": "color",
      "$description": "Neutros. 600 é o cinza do subtítulo do logotipo; 900 é o preto de 'uni'.",
      "0": { "$value": "#FFFFFF" },
      "50": { "$value": "#F7F7F8" },
      "100": { "$value": "#EFEFF1" },
      "200": { "$value": "#E2E2E5" },
      "300": { "$value": "#C9C9CE" },
      "400": { "$value": "#9E9EA4" },
      "500": { "$value": "#737379" },
      "600": { "$value": "#58585A" },
      "700": { "$value": "#414144" },
      "800": { "$value": "#2A2A2D" },
      "900": { "$value": "#18181A" }
    },
    "sucesso": {
      "$type": "color",
      "texto": { "$value": "#1E7A4C" },
      "fundo": { "$value": "#E7F5EE" },
      "borda": { "$value": "#9FD3B8" }
    },
    "aviso": {
      "$type": "color",
      "texto": { "$value": "#8A5A00" },
      "fundo": { "$value": "#FFF5D6" },
      "borda": { "$value": "#F0CF73" }
    },
    "perigo": {
      "$type": "color",
      "texto": { "$value": "#B42318" },
      "fundo": { "$value": "#FDECEA" },
      "borda": { "$value": "#F2AFA8" }
    },
    "info": {
      "$type": "color",
      "texto": { "$value": "#1D5FA8" },
      "fundo": { "$value": "#E8F1FB" },
      "borda": { "$value": "#A9C8EC" }
    },
    "dados": {
      "$type": "color",
      "$description": "Cores das chapas em gráficos, atribuídas pela ordem do número da chapa, nunca pelo resultado. O laranja da marca fica de fora de propósito: nenhuma chapa pode parecer 'a oficial'. Validadas para daltonismo; sempre acompanhadas de tabela e rótulo.",
      "1": { "$value": "#2A78D6" },
      "2": { "$value": "#1BAF7A" },
      "3": { "$value": "#6250D6" },
      "4": { "$value": "#EDA100" },
      "5": { "$value": "#E87BA4" },
      "6": { "$value": "#008300" },
      "branco-nulo": { "$value": "#9E9EA4", "$description": "Brancos e nulos: neutro, nunca uma cor de chapa." }
    }
  },
  "tema": {
    "$description": "Papéis semânticos. Telas e componentes usam ESTES nomes, não a escala crua.",
    "superficie": {
      "$type": "color",
      "pagina": { "$value": "{cor.grafite.50}" },
      "cartao": { "$value": "{cor.grafite.0}" },
      "rebaixada": { "$value": "{cor.grafite.100}" },
      "escura": { "$value": "{cor.grafite.900}", "$description": "Barra superior, menu lateral e urna em espera." },
      "destaque": { "$value": "{cor.laranja.50}" }
    },
    "texto": {
      "$type": "color",
      "principal": { "$value": "{cor.grafite.900}" },
      "secundario": { "$value": "{cor.grafite.600}" },
      "desabilitado": { "$value": "{cor.grafite.500}" },
      "inverso": { "$value": "{cor.grafite.0}" },
      "inverso-secundario": { "$value": "{cor.grafite.300}" },
      "marca": { "$value": "{cor.laranja.700}" },
      "link": { "$value": "{cor.laranja.700}" }
    },
    "borda": {
      "$type": "color",
      "padrao": { "$value": "{cor.grafite.200}" },
      "forte": { "$value": "{cor.grafite.300}" },
      "foco": { "$value": "{cor.laranja.700}" }
    },
    "acao": {
      "$type": "color",
      "primaria": { "$value": "{cor.laranja.700}" },
      "primaria-hover": { "$value": "{cor.laranja.800}" },
      "primaria-texto": { "$value": "{cor.grafite.0}" },
      "secundaria": { "$value": "{cor.grafite.900}" },
      "secundaria-hover": { "$value": "{cor.grafite.700}" },
      "acento": { "$value": "{cor.laranja.500}", "$description": "Detalhe de marca: barra ativa no menu, sublinhado, ícone." }
    },
    "terminal": {
      "$type": "color",
      "$description": "Estados do terminal no painel do mesário (H5, H9). Sempre com rótulo e ícone, nunca só a cor.",
      "livre": { "$value": "{cor.sucesso.texto}" },
      "liberado": { "$value": "{cor.laranja.600}" },
      "votando": { "$value": "{cor.info.texto}" },
      "inativo": { "$value": "{cor.grafite.400}" }
    }
  },
  "fonte": {
    "familia": {
      "$type": "fontFamily",
      "titulo": { "$value": "Poppins", "$extensions": { "br.digitech.fallback": "system-ui, sans-serif" }, "$description": "A mesma do site da UniCatólica. Títulos, números grandes, marca." },
      "texto": { "$value": "Inter", "$extensions": { "br.digitech.fallback": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif" }, "$description": "Texto corrido, formulários, tabelas." },
      "mono": { "$value": "JetBrains Mono", "$extensions": { "br.digitech.fallback": "ui-monospace, SFMono-Regular, Menlo, monospace" }, "$description": "Matrícula, UUID, códigos." }
    },
    "peso": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medio": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "tamanho": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem", "$description": "12px — legendas" },
      "sm": { "$value": "0.875rem", "$description": "14px — texto auxiliar, tabelas densas" },
      "md": { "$value": "1rem", "$description": "16px — texto padrão" },
      "lg": { "$value": "1.125rem", "$description": "18px" },
      "xl": { "$value": "1.25rem", "$description": "20px — título de cartão" },
      "2xl": { "$value": "1.5rem", "$description": "24px — título de seção; mínimo na urna" },
      "3xl": { "$value": "2rem", "$description": "32px — título de página; botões da urna" },
      "4xl": { "$value": "2.5rem", "$description": "40px — título da urna" },
      "5xl": { "$value": "3.5rem", "$description": "56px — número da chapa, número de destaque" }
    },
    "altura-linha": {
      "$type": "number",
      "justa": { "$value": 1.2 },
      "padrao": { "$value": 1.5 }
    }
  },
  "espaco": {
    "$type": "dimension",
    "$description": "Grade de 4px.",
    "0": { "$value": "0" },
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.5rem" },
    "6": { "$value": "2rem" },
    "7": { "$value": "3rem" },
    "8": { "$value": "4rem" }
  },
  "raio": {
    "$type": "dimension",
    "sm": { "$value": "6px" },
    "md": { "$value": "10px" },
    "lg": { "$value": "16px" },
    "pilula": { "$value": "999px" }
  },
  "sombra": {
    "$type": "shadow",
    "sm": { "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#18181A14" } },
    "md": { "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "-2px", "color": "#18181A1F" } },
    "lg": { "$value": { "offsetX": "0px", "offsetY": "16px", "blur": "40px", "spread": "-8px", "color": "#18181A40" } }
  },
  "tamanho-toque": {
    "$type": "dimension",
    "minimo": { "$value": "48px", "$description": "Alvo mínimo de toque/clique (H7)." },
    "urna": { "$value": "88px", "$description": "Altura das opções na urna." }
  }
}
