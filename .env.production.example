# =============================================================================
# Votação DigiTech: modelo do ambiente de PRODUÇÃO (Hostinger compartilhada)
#
# No servidor:  cp .env.production.example .env  →  preencher os TROCAR  →
#               php artisan key:generate  →  php artisan config:cache
# O .env preenchido NUNCA vai para o Git. Passo a passo: docs/DEPLOY_HOSTINGER.md
# Tudo marcado TROCAR precisa ser preenchido; o resto já está no valor de produção.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_NAME="Votação DigiTech"
APP_ENV=production
# Gerado no servidor com: php artisan key:generate (não reaproveite a chave local)
APP_KEY=
# NUNCA true em produção: mostraria senhas do .env e o código em qualquer erro
APP_DEBUG=false
APP_URL=https://TROCAR_DOMINIO

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Fortaleza

APP_MAINTENANCE_DRIVER=file

# --- Segurança ---------------------------------------------------------------
BCRYPT_ROUNDS=12

# --- Logs (um arquivo por dia, guarda 30 dias, só avisos e erros) ------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Banco de dados (hPanel → Bancos de dados → MySQL) -----------------------
# A Hostinger prefixa nome e usuário com u123456789_. Copie exatamente do hPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=TROCAR_u000000000_votacao
DB_USERNAME=TROCAR_u000000000_votacao
DB_PASSWORD=TROCAR_SENHA_FORTE

# --- Sessão (cookies só por HTTPS, criptografados, não acessíveis por JS) ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Cache, fila e arquivos (hospedagem compartilhada não tem worker, D8) ----
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- E-mail ------------------------------------------------------------------
# Enquanto o sistema não envia e-mail, fica no log. Para enviar pela Hostinger
# (hPanel → E-mails), troque por:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465
#   MAIL_USERNAME=nao-responda@TROCAR_DOMINIO
#   MAIL_PASSWORD=TROCAR_SENHA_DO_EMAIL
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@TROCAR_DOMINIO"
MAIL_FROM_NAME="${APP_NAME}"
