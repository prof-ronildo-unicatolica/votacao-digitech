# =============================================================================
# Votação DigiTech: modelo do ambiente LOCAL (desenvolvimento)
# Copie para .env (cp .env.example .env) e rode: php artisan key:generate
# Produção (Hostinger): use .env.production.example
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
APP_NAME="Votação DigiTech"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Fortaleza

# Modo de manutenção (php artisan down)
APP_MAINTENANCE_DRIVER=file

# --- Segurança ---------------------------------------------------------------
BCRYPT_ROUNDS=12

# --- Logs --------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Banco de dados ----------------------------------------------------------
# XAMPP padrão: usuário root sem senha. LAMP: o usuário criado em INSTALACAO_LAMP.md.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=votacao_digitech
DB_USERNAME=root
DB_PASSWORD=

# --- Sessão ------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Cache, fila e arquivos (iguais à hospedagem compartilhada, D8) ----------
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- E-mail (local: grava no log em storage/logs) ----------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@digitech.local"
MAIL_FROM_NAME="${APP_NAME}"
